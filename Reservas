<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>JH Violinista — Cotizador y Reserva Interactiva</title>
    <style>
        :root {
            --bg-color: #ffffff;
            --text-color: #000000;
            --card-bg: #f9f9f9;
            --border-color: #000000;
            --accent-color: #000000;
            --font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: var(--font-family);
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-color);
            padding: 20px 15px;
            max-width: 600px;
            margin: 0 auto;
            line-height: 1.5;
        }

        header {
            text-align: center;
            border-bottom: 2px solid var(--border-color);
            padding-bottom: 20px;
            margin-bottom: 25px;
        }

        header h1 {
            font-size: 26px;
            letter-spacing: 3px;
            text-transform: uppercase;
            font-weight: 800;
        }

        header p {
            font-size: 13px;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: #555;
            margin-top: 5px;
        }

        .step-title {
            font-size: 14px;
            letter-spacing: 2px;
            text-transform: uppercase;
            font-weight: 700;
            margin-bottom: 15px;
            border-left: 4px solid var(--border-color);
            padding-left: 10px;
        }

        .section {
            margin-bottom: 30px;
        }

        /* Tarjetas de Plan */
        .grid-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
        }

        .card {
            border: 1px solid var(--border-color);
            padding: 15px;
            border-radius: 6px;
            background-color: var(--card-bg);
            cursor: pointer;
            transition: all 0.2s ease;
            text-align: center;
            position: relative;
        }

        .card.selected {
            background-color: #000;
            color: #fff;
            border-color: #000;
        }

        .card h3 {
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 8px;
        }

        .card .price {
            font-size: 18px;
            font-weight: bold;
            margin-top: 10px;
        }

        /* Checkbox de Momentos */
        .checkbox-group {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }

        .checkbox-card {
            border: 1px solid #ccc;
            padding: 12px;
            border-radius: 6px;
            display: flex;
            align-items: center;
            gap: 10px;
            cursor: pointer;
            font-size: 13px;
            font-weight: 600;
        }

        .checkbox-card input {
            accent-color: #000;
            transform: scale(1.2);
        }

        /* Opciones de Vestuario */
        .style-options {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }

        .style-btn {
            border: 1px solid var(--border-color);
            padding: 12px;
            background: #fff;
            text-align: center;
            font-size: 12px;
            letter-spacing: 1px;
            text-transform: uppercase;
            font-weight: 600;
            cursor: pointer;
            border-radius: 4px;
        }

        .style-btn.selected {
            background: #000;
            color: #fff;
        }

        /* Resumen Fijo en la parte inferior */
        .summary-box {
            border: 2px solid var(--border-color);
            padding: 20px;
            border-radius: 8px;
            background-color: #fff;
            margin-top: 20px;
        }

        .summary-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 8px;
            font-size: 14px;
        }

        .summary-row.total {
            font-weight: bold;
            font-size: 16px;
            border-top: 1px solid #ddd;
            padding-top: 8px;
            margin-top: 10px;
        }

        .btn-whatsapp {
            display: block;
            width: 100%;
            background-color: #000;
            color: #fff;
            text-align: center;
            padding: 16px;
            font-size: 14px;
            letter-spacing: 2px;
            text-transform: uppercase;
            font-weight: bold;
            text-decoration: none;
            border-radius: 6px;
            margin-top: 15px;
            transition: background 0.3s ease;
        }

        .btn-whatsapp:hover {
            background-color: #333;
        }
    </style>
</head>
<body>

    <header>
        <h1>JH Violinista</h1>
        <p>Configurador & Reserva de Experiencia</p>
    </header>

    <!-- Paso 1: Selección de Plan -->
    <div class="section">
        <div class="step-title">1. Selecciona tu Plan Base</div>
        <div class="grid-2">
            <div class="card selected" id="plan-clasica" onclick="selectPlan('clasica', 900)">
                <h3>Clásica</h3>
                <p style="font-size: 11px;">1 Hora + 30 min cortesía</p>
                <div class="price">Q900.00</div>
            </div>
            <div class="card" id="plan-elite" onclick="selectPlan('elite', 1800)">
                <h3>Elite</h3>
                <p style="font-size: 11px;">2 Horas (Logística 4 hrs)</p>
                <div class="price">Q1,800.00</div>
            </div>
        </div>
    </div>

    <!-- Paso 2: Momentos de Cobertura -->
    <div class="section" id="section-momentos">
        <div class="step-title">2. Momentos a Amenizar</div>
        <div class="checkbox-group">
            <label class="checkbox-card">
                <input type="checkbox" id="m-ceremonia" checked onchange="updateSummary()"> Ceremonia
            </label>
            <label class="checkbox-card">
                <input type="checkbox" id="m-coctel" checked onchange="updateSummary()"> Cóctel
            </label>
            <label class="checkbox-card">
                <input type="checkbox" id="m-cena" onchange="updateSummary()"> Cena
            </label>
            <label class="checkbox-card">
                <input type="checkbox" id="m-especial" onchange="updateSummary()"> Show Especial
            </label>
        </div>
    </div>

    <!-- Paso 3: Código de Vestimenta -->
    <div class="section">
        <div class="step-title">3. Estilo de Vestuario del Artista</div>
        <div class="style-options">
            <div class="style-btn selected" onclick="selectStyle(this, 'Smoking Black Tie')">Smoking / Black Tie</div>
            <div class="style-btn" onclick="selectStyle(this, 'Traje Formal Oscuro')">Traje Formal</div>
            <div class="style-btn" onclick="selectStyle(this, 'Semi-Formal / Lino')">Semi-Formal / Lino</div>
            <div class="style-btn" onclick="selectStyle(this, 'Show Eléctrico Moderno')">Moderno Eléctrico</div>
        </div>
    </div>

    <!-- Resumen y Pago -->
    <div class="summary-box">
        <div class="step-title" style="border:none; padding:0; margin-bottom:10px;">Resumen de Reserva</div>
        <div class="summary-row"><span>Plan Seleccionado:</span> <strong id="res-plan">Experiencia Clásica</strong></div>
        <div class="summary-row"><span>Etiqueta:</span> <strong id="res-estilo">Smoking Black Tie</strong></div>
        <div class="summary-row"><span>Costo Total:</span> <strong id="res-total">Q900.00</strong></div>
        <div class="summary-row total"><span>Anticipo para Reserva (50%):</span> <strong id="res-anticipo">Q450.00</strong></div>

        <a href="#" id="btn-reservar" class="btn-whatsapp" target="_blank">Confirmar y Reservar vía WhatsApp</a>
    </div>

    <script>
        let currentPlan = 'Experiencia Clásica';
        let currentPrice = 900;
        let currentStyle = 'Smoking Black Tie';
        const telefonoWhatsApp = '50259268980'; // Tu número registrado

        function selectPlan(planKey, price) {
            document.getElementById('plan-clasica').classList.remove('selected');
            document.getElementById('plan-elite').classList.remove('selected');

            if(planKey === 'clasica') {
                document.getElementById('plan-clasica').classList.add('selected');
                currentPlan = 'Experiencia Clásica';
            } else {
                document.getElementById('plan-elite').classList.add('selected');
                currentPlan = 'Experiencia Elite';
            }
            currentPrice = price;
            updateSummary();
        }

        function selectStyle(element, styleName) {
            const buttons = document.querySelectorAll('.style-btn');
            buttons.forEach(btn => btn.classList.remove('selected'));
            element.classList.add('selected');
            currentStyle = styleName;
            updateSummary();
        }

        function updateSummary() {
            document.getElementById('res-plan').innerText = currentPlan;
            document.getElementById('res-estilo').innerText = currentStyle;
            document.getElementById('res-total').innerText = 'Q' + currentPrice + '.00';
            
            let anticipo = currentPrice * 0.5;
            document.getElementById('res-anticipo').innerText = 'Q' + anticipo + '.00';

            // Momentos seleccionados
            let momentos = [];
            if(document.getElementById('m-ceremonia').checked) momentos.push('Ceremonia');
            if(document.getElementById('m-coctel').checked) momentos.push('Cóctel');
            if(document.getElementById('m-cena').checked) momentos.push('Cena');
            if(document.getElementById('m-especial').checked) momentos.push('Show Especial');

            // Crear enlace dinámico de WhatsApp
            let mensaje = `¡Hola JH Violinista! Quisiera realizar la reserva de mi evento:%0A%0A` +
                          `• *Plan:* ${currentPlan}%0A` +
                          `• *Momentos:* ${momentos.join(', ')}%0A` +
                          `• *Vestuario:* ${currentStyle}%0A` +
                          `• *Total:* Q${currentPrice}.00%0A` +
                          `• *Anticipo a cancelar (50%):* Q${anticipo}.00%0A%0A` +
                          `¿Me compartes los datos de cuenta o enlace de pago para congelar mi fecha?`;

            document.getElementById('btn-reservar').href = `https://wa.me/${telefonoWhatsApp}?text=${mensaje}`;
        }

        // Inicializar
        updateSummary();
    </script>
</body>
</html>
